{
  "model_type": "qwen3_moe",
  "model_name": "Qwen3-30B-A3B-Instruct-2507",
  "module_input_name": "model.layers.{i}.input_layernorm",
  "module_output_name": "model.layers.{i}.self_attn.o_proj",
  "is_moe": true,
  "moe_config": {
    "router_module_name": "model.layers.{i}.mlp.gate",
    "expert_module_pattern": "model.layers.{i}.mlp.experts.{j}",
    "num_experts": 128,
    "num_experts_per_tok": 8,
    "has_shared_expert": false
  },
  "attention_config": {
    "num_hidden_layers": 48,
    "num_attention_heads": 32,
    "num_key_value_heads": 4,
    "head_dim": 128,
    "hidden_size": 2048,
    "q_norm": "model.layers.{i}.self_attn.q_norm",
    "k_norm": "model.layers.{i}.self_attn.k_norm"
  },
  "hook_targets": {
    "attention_input": "model.layers.{i}.input_layernorm",
    "attention_output": "model.layers.{i}.self_attn.o_proj",
    "q_proj": "model.layers.{i}.self_attn.q_proj",
    "k_proj": "model.layers.{i}.self_attn.k_proj",
    "v_proj": "model.layers.{i}.self_attn.v_proj",
    "router": "model.layers.{i}.mlp.gate",
    "expert_gate": "model.layers.{i}.mlp.experts.{j}.gate_proj",
    "expert_up": "model.layers.{i}.mlp.experts.{j}.up_proj",
    "expert_down": "model.layers.{i}.mlp.experts.{j}.down_proj"
  },
  "notes": "Configuration for Qwen3-30B-A3B MoE model path patching"
}
